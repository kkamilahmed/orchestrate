# Copy to .env and fill in. Without a key the app runs in offline mode (pre-written
# responses from the database, streamed word by word).
OPENROUTER_API_KEY=

# Any OpenRouter model id. Fast and cheap by default; swap freely.
OPENROUTER_MODEL=google/gemini-3.1-flash-lite

# The API connects as the least-privilege role created in schema.sql.
DATABASE_URL=postgres://orchestrate_app:orchestrate_app@localhost:5432/orchestrate

# Optional
# API_PORT=3001                      # the Next.js app proxies /api/* here
# FIRST_TOKEN_TIMEOUT_MS=12000       # fall back to offline if the model is silent this long
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
